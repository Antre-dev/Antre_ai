{
  "expo": {
    "name": "Antre Remote",
    "slug": "antre-remote",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "antre",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.antre.remote",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Antre Remote uses Face ID to confirm that you approve sensitive actions on your laptop."
      }
    },
    "android": {
      "package": "com.antre.remote",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30fd9962-652c-452c-b206-314ebb21d94d"
      }
    },
    "owner": "antredev"
  }
}
